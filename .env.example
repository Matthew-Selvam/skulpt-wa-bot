# WhatsApp Business API Configuration
# =====================================

# Webhook Configuration (for WhatsApp webhook verification)
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
WEBHOOK_SECRET=your_webhook_secret_here

# WhatsApp Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_from_meta_developer_console
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_from_meta
WHATSAPP_API_VERSION=v18.0

# Bot Configuration
BOT_NUMBER=918838975981
BOT_NAME=Skulpt
ADMIN_NUMBER=918838975981

# Invoice Configuration
USE_LETTERHEAD=true
LETTERHEAD_PATH=./letterhead_template.png
COMPANY_NAME=THYNK UNLIMITED
COMPANY_TAGLINE=Creative Company

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/trophybot

# Server Configuration
PORT=3000
NODE_ENV=development

# =====================================
# ADMIN DASHBOARD (v1.6.0)
# =====================================
# Required — /admin returns 503 without it, rather than using a default password
ADMIN_PASSWORD=
# Optional: sign session tokens with a dedicated secret. If unset, the key is
# derived from ADMIN_PASSWORD, so changing the password ends existing sessions.
ADMIN_JWT_SECRET=
ADMIN_SESSION_TTL=12h
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_RATE_LIMIT=100
WEBHOOK_RATE_LIMIT=600

# =====================================
# DELIVERY (v2.0.0)
# =====================================
# auto = use Porter when PORTER_API_KEY is set, otherwise the mock.
# Leaving PORTER_API_KEY blank keeps the simulated status updates.
DELIVERY_PROVIDER=auto
PORTER_API_KEY=
# ⚠️ The paths below are UNVERIFIED — written without access to Porter's docs.
# Confirm them against Porter's API reference before enabling the integration.
PORTER_API_URL=https://pfe-apigw.porter.in
PORTER_AUTH_HEADER=X-API-KEY
PORTER_CREATE_PATH=/v1/orders/create
PORTER_STATUS_PATH=/v1/orders/{id}
PORTER_CANCEL_PATH=/v1/orders/{id}/cancel
PORTER_POLL_INTERVAL_MS=120000
PORTER_TIMEOUT_MS=15000

# Pickup address handed to the delivery provider (Porter only)
PICKUP_ADDRESS=
PICKUP_CITY=
PICKUP_PINCODE=
PICKUP_CONTACT_NAME=
PICKUP_CONTACT_PHONE=

# Shown to the customer at checkout, before payment
DELIVERY_ESTIMATE_DAYS=5

# =====================================
# LOCALISATION (v2.0.0)
# =====================================
# Supported: en, hi
DEFAULT_LOCALE=en

# Max size of a customer-sent reference image (bytes)
MAX_IMAGE_BYTES=5242880

# =====================================
# SETUP INSTRUCTIONS
# =====================================
#
# 1. Go to https://developers.facebook.com/apps
# 2. Create a new app or select existing app
# 3. Add WhatsApp product to your app
# 4. Get your Access Token from WhatsApp > API Setup
# 5. Get your Phone Number ID from WhatsApp > API Setup
# 6. Configure webhook:
#    - Callback URL: https://your-domain.com/webhook
#    - Verify Token: Use the WEBHOOK_VERIFY_TOKEN value
#    - Subscribe to 'messages' field
# 7. Generate WEBHOOK_SECRET for signature validation
# 8. Update all values above with your actual credentials
#
# =====================================
